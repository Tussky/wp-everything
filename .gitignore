# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# Node / Python / generic build artifacts
node_modules/
.venv/
venv/
.env
.env.*
__pycache__/
*.pyc

# Scratch / temp scratch
scratch/tmp/

# Local Paperclip config — do not track
.claude/

# Transient sandbox queue files — do not track
/wordpress-sandbox/request.json
/wordpress-sandbox/result.json
/wordpress-sandbox/request.processed.*.json
/wordpress-sandbox/request.rejected.*.json
/wordpress-sandbox/request.failed.*.json

# Sandbox runtime manifest is generated by the runner and contains local-only creds — do not track
/wordpress-sandbox/docker-compose.yml
/wordpress-sandbox/.gitignore

# WordPress core / bundled content shipped by the sandbox image — not our code
/wordpress-sandbox/wp-content/index.php
/wordpress-sandbox/wp-content/plugins/akismet/
/wordpress-sandbox/wp-content/plugins/hello.php
/wordpress-sandbox/wp-content/plugins/index.php
/wordpress-sandbox/wp-content/themes/
/wordpress-sandbox/wp-content/uploads/
/wordpress-sandbox/wp-content/upgrade/
/wordpress-sandbox/wp-content/cache/

# Third-party WordPress plugin dependencies — pulled in by the sandbox, not authored here
/wordpress-sandbox/wp-content/plugins/redirection/

# PHPCS vendor — installed by the sandbox runner, regenerable
/wordpress-sandbox/wp-content/phpcs-vendor/

# Keep our plugins and the SMR-side mu-plugin scaffold tracked
!/wordpress-sandbox/wp-content/plugins/site-map-redirects/
!/wordpress-sandbox/wp-content/mu-plugins/