# Transient sandbox queue files — do not track
/request.json
/result.json
/request.processed.*.json
/request.rejected.*.json
/request.failed.*.json

# Sandbox runtime manifest is generated by the runner and contains local-only creds — do not track
/docker-compose.yml

# WordPress core/bundled content shipped by the sandbox image — not our code
/wp-content/index.php
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php
/wp-content/plugins/index.php
/wp-content/themes/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/

# Keep our plugin tracked
!/wp-content/plugins/site-map-redirects/
